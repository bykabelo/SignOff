# Copy to .env.local and fill in.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Used to build review links in emails and the onboarding done screen.
# Set to your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe ───────────────────────────────────────────────
# Optional: with these unset the app runs normally and the billing page
# reports that billing is not configured. Everything else still works.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...), not product IDs.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STUDIO=
